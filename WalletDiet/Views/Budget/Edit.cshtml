@model WalletDiet.ViewModels.EditBudgetViewModel

@{
    Layout = null;

    var startDateValue = Model.StartDate.ToString("yyyy-MM-dd");
    var targetDateValue = Model.TargetDate.ToString("yyyy-MM-dd");
    var budgetId = ViewContext.RouteData.Values["id"];
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Edit Budget - WalletDiet</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/auth.css" />
    <link rel="stylesheet" href="~/css/dashboard.css" />
    <link rel="stylesheet" href="~/css/create-budget.css" />
    <link rel="stylesheet" href="~/css/edit-budget.css" />
</head>

<body data-scene="dark" data-bs-theme="dark">

    <div class="g-scene">
        <i></i>
        <i></i>
        <i></i>
        <i></i>
    </div>

    <main class="dashboard-wrap">

        <div class="dashboard-container budget-container">

            <!-- Heading -->
            <div class="budget-heading">

                <span class="budget-eyebrow">BUDGET MANAGEMENT</span>

                <h1>Edit Your Budget</h1>

                <p>
                    Update your budget period and daily allowance settings.
                    Keep your financial plan on track.
                </p>

            </div>

            <!-- Form -->
            <form asp-controller="Budget"
                  asp-action="Edit"
                  method="post"
                  class="g-form budget-form"
                  id="editBudgetForm">

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary">
                </div>

                <input type="hidden"
                       name="id"
                       value="@budgetId" />

                <input type="hidden"
                       asp-for="Status" />

                <!-- Budget Period -->
                <div class="date-fields">

                    <!-- Start Date -->
                    <div class="form-group">

                        <label asp-for="StartDate">
                            Start Date
                        </label>

                        <input asp-for="StartDate"
                               type="date"
                               class="form-control"
                               id="startDateInput"
                               value="@startDateValue"
                               readonly="@(Model.Status == "Active")" />

                        <span asp-validation-for="StartDate"
                              class="field-error">
                        </span>

                    </div>

                    <!-- Target Date -->
                    <div class="form-group">

                        <label asp-for="TargetDate">
                            Target Date
                        </label>

                        <input asp-for="TargetDate"
                               type="date"
                               class="form-control"
                               id="targetDateInput"
                               value="@targetDateValue"
                               min="@startDateValue" />

                        <span asp-validation-for="TargetDate"
                              class="field-error">
                        </span>

                    </div>

                    <small class="field-hint period-hint">
                        Update when your budget period starts and ends.
                    </small>

                </div>

                @if (Model.Status == "Active")
                {
                    <small class="field-hint edit-status-hint">
                        <span>&#9432;</span>
                        Start date cannot be changed once a budget becomes active.
                    </small>
                }

                <!-- Daily Allowance -->
                <div class="form-group allowance-section">

                    <label class="section-label">
                        Daily Allowance Mode
                    </label>

                    <p class="section-description">
                        Choose how you want to manage your daily spending limit.
                    </p>

                    <div class="allowance-options">

                        <!-- Recommended -->
                        <label class="allowance-option">

                            <input asp-for="AllowanceMode"
                                   type="radio"
                                   value="Recommended"
                                   id="recommendedOption" />

                            <span class="option-content">

                                <span class="option-title">
                                    Recommended
                                </span>

                                <span class="option-description">
                                    Automatically calculate your daily allowance
                                    based on your remaining balance and days.
                                </span>

                            </span>

                        </label>

                        <!-- Custom -->
                        <label class="allowance-option">

                            <input asp-for="AllowanceMode"
                                   type="radio"
                                   value="Custom"
                                   id="customOption" />

                            <span class="option-content">

                                <span class="option-title">
                                    Custom
                                </span>

                                <span class="option-description">
                                    Set your own daily spending limit.
                                </span>

                            </span>

                        </label>

                    </div>

                    <span asp-validation-for="AllowanceMode"
                          class="field-error">
                    </span>

                </div>

                <!-- Custom Daily Allowance -->
                <div class="form-group custom-allowance-group"
                     id="customAllowanceGroup">

                    <label for="customAllowanceDisplay">
                        Custom Daily Allowance
                    </label>

                    <div class="input-wrapper">

                        <span class="input-prefix">Rp</span>

                        <input type="text"
                               id="customAllowanceDisplay"
                               class="form-control currency-input"
                               placeholder="100.000"
                               inputmode="numeric"
                               autocomplete="off" />

                        <input type="hidden"
                               asp-for="CustomDailyAllowance"
                               id="customAllowanceValue" />

                    </div>

                    <span asp-validation-for="CustomDailyAllowance"
                          class="field-error">
                    </span>

                    <small class="field-hint">
                        You can change this allowance later.
                    </small>

                </div>

                <!-- Actions -->
                <div class="form-actions">

                    <a asp-controller="Budget"
                       asp-action="MyBudgets"
                       class="btn-cancel">
                        Back
                    </a>

                    <button type="submit" class="btn-create">
                        Save Changes
                        <span>&rarr;</span>
                    </button>

                </div>

            </form>

        </div>

    </main>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const allowanceRadios = document.querySelectorAll(
                'input[name="AllowanceMode"]'
            );

            const customGroup = document.getElementById("customAllowanceGroup");
            const customDisplay = document.getElementById("customAllowanceDisplay");
            const customValue = document.getElementById("customAllowanceValue");
            const form = document.getElementById("editBudgetForm");

            function formatRupiah(value) {
                const number = value.replace(/\D/g, "");

                return number
                    ? new Intl.NumberFormat("id-ID").format(number)
                    : "";
            }

            function updateAllowanceMode() {

                const selected = document.querySelector(
                    'input[name="AllowanceMode"]:checked'
                );

                const isCustom = selected && selected.value === "Custom";

                customGroup.classList.toggle("is-visible", isCustom);
            }

            // Load existing custom allowance
            const existingValue = Number(customValue.value.replace(",", "."));

            if (Number.isFinite(existingValue) && existingValue > 0) {
                customDisplay.value = formatRupiah(
                    String(Math.round(existingValue))
                );
            }

            // Format currency input
            customDisplay.addEventListener("input", function () {

                const rawValue = this.value.replace(/\D/g, "");

                customValue.value = rawValue;
                this.value = formatRupiah(rawValue);

            });

            // Toggle custom allowance
            allowanceRadios.forEach(function (radio) {
                radio.addEventListener("change", updateAllowanceMode);
            });

            // Synchronize value before submission
            form.addEventListener("submit", function () {

                customValue.value = customDisplay.value.replace(/\D/g, "");

            });

            updateAllowanceMode();

        });
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

</body>
</html>
