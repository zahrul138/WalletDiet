@model IEnumerable<WalletDiet.Models.Budget>
@using System.Globalization

@{
    Layout = null;
    var culture = CultureInfo.GetCultureInfo("id-ID");
    var budgets = Model ?? Enumerable.Empty<WalletDiet.Models.Budget>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>My Budgets - WalletDiet</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/auth.css" />
    <link rel="stylesheet" href="~/css/dashboard.css" />
    <link rel="stylesheet" href="~/css/my-budgets.css" />
</head>

<body data-scene="dark">

    <div class="g-scene"></div>

    <div class="dashboard-wrap">
        <div class="dashboard-container budgets-container">

            <!-- Navigation -->
            <div class="budgets-nav">
                <a asp-controller="Dashboard"
                   asp-action="Dashboard"
                   class="back-link">
                    <span class="back-arrow">←</span>
                    Back to Dashboard
                </a>
            </div>

            <!-- Page Content -->
            <section class="budgets-glass">

                <!-- Page Header -->
                <div class="budgets-header">
                    <div>
                        <span class="budgets-eyebrow">WALLETDIET MANAGEMENT</span>
                        <h1>My Budgets</h1>
                        <p>Manage your spending periods and track your budget history.</p>
                    </div>

                    <a asp-controller="Budget"
                       asp-action="Create"
                       class="new-budget-btn">
                        <span>+</span>
                        New Budget
                    </a>
                </div>

                <!-- Budget Filters -->
                <div class="budget-filters">

                    <button type="button"
                            class="filter-btn active"
                            data-filter="all">
                        All
                        <span class="filter-count">@budgets.Count()</span>
                    </button>

                    <button type="button"
                            class="filter-btn"
                            data-filter="active">
                        Active
                    </button>

                    <button type="button"
                            class="filter-btn"
                            data-filter="upcoming">
                        Upcoming
                    </button>

                    <button type="button"
                            class="filter-btn"
                            data-filter="completed">
                        Completed
                    </button>

                </div>

                <!-- Budget List -->
                <div class="budgets-list" id="budgetsList">

                    @if (budgets.Any())
                    {
                        foreach (var budget in budgets)
                        {
                            var status = (budget.Status ?? "").ToLowerInvariant();

                            <article class="budget-card"
                                     data-status="@status">

                                <div class="budget-card-top">

                                    <div class="budget-period">
                                        <span class="budget-period-label">BUDGET PERIOD</span>

                                        <h2>
                                            @budget.StartDate.ToString("dd MMM yyyy", culture)
                                            <span class="period-separator">—</span>
                                            @budget.TargetDate.ToString("dd MMM yyyy", culture)
                                        </h2>
                                    </div>

                                    <span class="budget-status status-@status">
                                        @budget.Status
                                    </span>

                                </div>

                                <div class="budget-card-details">

                                    <div class="budget-detail">
                                        <span class="detail-label">Initial Balance</span>
                                        <strong>
                                            @budget.InitialBalance.ToString("C0", culture)
                                        </strong>
                                    </div>

                                    <div class="budget-detail">
                                        <span class="detail-label">Allowance Mode</span>
                                        <strong>
                                            @budget.AllowanceMode
                                        </strong>
                                    </div>

                                    @if (budget.AllowanceMode == "Custom"
                                                                && budget.CustomDailyAllowance.HasValue)
                                    {
                                        <div class="budget-detail">
                                            <span class="detail-label">Custom Daily Allowance</span>
                                            <strong>
                                                @budget.CustomDailyAllowance.Value.ToString("C0", culture)
                                            </strong>
                                        </div>
                                    }

                                </div>

                                <div class="budget-card-actions">

                                    <a asp-controller="Budget"
                                       asp-action="Edit"
                                       asp-route-id="@budget.Id"
                                       class="budget-edit-btn">
                                        Edit Budget
                                    </a>

                                    @if (status == "upcoming")
                                    {
                                        <form asp-controller="Budget"
                                              asp-action="Delete"
                                              asp-route-id="@budget.Id"
                                              method="post"
                                              class="delete-budget-form">

                                            <button type="button"
                                                    class="budget-delete-btn">
                                                Delete
                                            </button>

                                        </form>
                                    }

                                </div>

                            </article>
                        }
                    }
                    else
                    {
                        <div class="budgets-empty">
                            <div class="empty-icon">◷</div>
                            <h3>No budgets yet</h3>
                            <p>You haven't created any budgets. Start by creating your first budget.</p>

                            <a asp-controller="Budget"
                               asp-action="Create"
                               class="new-budget-btn empty-create-btn">
                                <span>+</span>
                                Create Your First Budget
                            </a>
                        </div>
                    }

                </div>

                <div class="budgets-filter-empty" id="filterEmpty" hidden>
                    <p>No budgets found in this category.</p>
                </div>

            </section>

        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="delete-modal-overlay"
         id="deleteModal"
         aria-hidden="true"
         hidden>

        <div class="delete-modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="deleteModalTitle">

            <div class="delete-modal-icon">
                <span>!</span>
            </div>

            <div class="delete-modal-content">
                <span class="delete-modal-eyebrow">CONFIRMATION</span>

                <h2 id="deleteModalTitle">Delete This Budget?</h2>

                <p>
                    Are you sure you want to delete this upcoming budget?
                    This action cannot be undone.
                </p>
            </div>

            <div class="delete-modal-actions">

                <button type="button"
                        class="delete-modal-cancel"
                        id="cancelDelete">
                    Cancel
                </button>

                <button type="button"
                        class="delete-modal-confirm"
                        id="confirmDelete">
                    Delete Budget
                </button>

            </div>

        </div>
    </div>

    <script src="~/js/my-budgets.js" asp-append-version="true"></script>

</body>
</html>
