@model WalletDiet.ViewModels.LoginViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>

<body>

    <div class="gl position-relative overflow-hidden d-flex align-items-center justify-content-center">

        <div class="gl-blob gl-b1 position-absolute" aria-hidden="true"></div>
        <div class="gl-blob gl-b2 position-absolute" aria-hidden="true"></div>
        <div class="gl-blob gl-b3 position-absolute" aria-hidden="true"></div>

        <form class="card position-relative w-100" method="post">

            <div class="card-body">

                <h1 class="text-center">Sign in</h1>

                <p class="gl-sub text-center">
                    Welcome back — we kept your seat warm.
                </p>

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="gl-field">

                    <label asp-for="Email" class="form-label"></label>

                    <input asp-for="Email"
                           class="form-control"
                           placeholder="Your email address"
                           autocomplete="email" />

                    <span asp-validation-for="Email" class="text-danger"></span>

                </div>

                <div class="gl-field">

                    <label asp-for="Password" class="form-label"></label>

                    <input asp-for="Password"
                           class="form-control"
                           placeholder="Your password"
                           autocomplete="current-password" />

                    <span asp-validation-for="Password" class="text-danger"></span>

                </div>

                <p class="gl-alt text-center">
                    Forgot Password?

                    <a asp-area=""
                       asp-controller="Account"
                       asp-action="ForgotPassword">
                        Click here
                    </a>
                </p>

                <input asp-for="ReturnUrl" type="hidden" />

                <button class="btn btn-gl w-100" type="submit">
                    Login
                </button>

                <p class="gl-alt text-center mb-0">
                    First time here? 

                    <a asp-area=""
                       asp-controller="Account"
                       asp-action="Register">
                        Create an account
                    </a>
                </p>

            </div>

        </form>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

</body>

</html>
