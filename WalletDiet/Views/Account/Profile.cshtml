@model WalletDiet.ViewModels.ProfileViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Sign up</title>
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
        <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    </head>
    <body>
        <div data-scene="dark"  data-bs-theme="dark">
            <div class="g-scene" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
            <div class="wrap mt-4">
                <div class="row g-4 justify-content-center min-vh-100">
                    <div class="col-lg-8 d-flex flex-column gap-4">
                        <section class="card g-glass mx-auto">
                            <div class="card-body">

                                <!-- Profile Picture -->
                                <div class="profile-picture">

                                    <form asp-action="UpdateProfilePicture"
                                          asp-controller="Account"
                                          method="post"
                                          enctype="multipart/form-data"
                                          id="picture-form">

                                        <img src="@Url.Action("GetProfilePicture", "Account")"
                                             alt="Profile Picture"
                                             id="profile-picture-preview" />

                                        <!-- Edit Picture Button -->
                                        <button type="button"
                                                class="profile-edit-btn picture-edit"
                                                id="edit-picture">

                                            <svg viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="2"
                                                 stroke-linecap="round"
                                                 stroke-linejoin="round">

                                                <path d="M12 20h9" />
                                                <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z" />

                                            </svg>

                                        </button>

                                        <input asp-for="PictureFile"
                                               type="file"
                                               id="picture-input"
                                               accept="image/jpeg,image/png,image/webp"
                                               hidden />

                                        <!-- Save & Cancel -->
                                        <div class="picture-actions d-none" id="picture-actions">

                                            <button type="submit" id="save-picture">
                                                Save
                                            </button>

                                            <button type="button" id="cancel-picture">
                                                Cancel
                                            </button>

                                        </div>

                                    </form>

                                    <!-- Remove Picture -->
                                    @if (!string.IsNullOrEmpty(Model.ProfilePicture))
                                    {
                                        <form asp-action="RemoveProfilePicture"
                                              asp-controller="Account"
                                              method="post"
                                              id="remove-picture-form">

                                            <button type="submit"
                                                    id="remove-picture"
                                                    class="d-none">

                                                Remove

                                            </button>

                                        </form>
                                    }

                                </div>
                            

                                <!-- Username -->
                                <form asp-action="UpdateUsername" asp-controller="Account" method="post" id="username-form">
                                    <div class="profile-name-wrapper">
                                        <h4 class="profile-name" id="username-display">
                                            @Model.Username
                                        </h4>
                                    <input asp-for="Username" class="form-control profile-name d-none" id="username-input" autocomplete="username" maxlength="20"
                                           minlength="5" readonly />
                                        <button type="button" class="profile-edit-btn" id="edit-username" aria-label="Edit username" title="Edit username">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M12 20h9" />
                                            <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z" />
                                        </svg>
                                        </button>
                                    </div>
                                    <span asp-validation-for="Username" class="text-danger"></span>
                                </form>

                                <!-- Form -->
                                <div class="g-form d-grid gap-3 mt-4">

                                    <!-- Email -->
                                    <form asp-action="UpdateEmail"
                                          asp-controller="Account"
                                          method="post"
                                          id="email-form"
                                          data-editing="@(ViewBag.IsEditingEmail == true ? "true" : "false")"
                                          novalidate>

                                        <div>
                                            <div class="profile-label">
                                                <label class="form-label" for="profile-email">
                                                    Email
                                                </label>

                                                <button type="button"
                                                        class="profile-edit-btn"
                                                        id="edit-email"
                                                        aria-label="Edit email"
                                                        title="Edit email">

                                                    <svg id="email-edit-icon"
                                                         viewBox="0 0 24 24"
                                                         fill="none"
                                                         stroke="currentColor"
                                                         stroke-width="2"
                                                         stroke-linecap="round"
                                                         stroke-linejoin="round">

                                                        <path d="M12 20h9" />
                                                        <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z" />
                                                    </svg>

                                                </button>
                                            </div>

                                            <input asp-for="Email"
                                                   class="form-control w-100"
                                                   id="profile-email"
                                                   type="email"
                                                   disabled />

                                            <span asp-validation-for="Email"
                                                  class="text-danger"></span>
                                        </div>

                                    </form>

                                     <!-- Password -->
                                    <form asp-action="UpdatePassword"
                                          asp-controller="Account"
                                          method="post"
                                          id="password-form"
                                          data-editing="@(ViewBag.IsEditingPassword == true ? "true" : "false")">

                                        <div>
                                            <div class="profile-label">
                                                <label class="form-label">Change Password</label>

                                                <button type="button"
                                                        class="profile-edit-btn"
                                                        id="edit-password"
                                                        aria-label="Edit password"
                                                        title="Edit password">

                                                    <svg id="password-edit-icon"
                                                         viewBox="0 0 24 24"
                                                         fill="none"
                                                         stroke="currentColor"
                                                         stroke-width="2"
                                                         stroke-linecap="round"
                                                         stroke-linejoin="round">

                                                        <path d="M12 20h9" />
                                                        <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z" />
                                                    </svg>
                                                </button>
                                            </div>

                                        <div class="mb-3">
                                            <label asp-for="CurrentPassword" class="form-label">
                                                Current Password
                                            </label>

                                            <div class="password-input-wrapper">
                                                <input asp-for="CurrentPassword"
                                                       class="form-control"
                                                       id="current-password"
                                                       type="password"
                                                       placeholder="Enter current password"
                                                       disabled />

                                                <button type="button"
                                                        class="toggle-password"
                                                        id="toggle-current-password"
                                                        aria-label="Hold to show password"
                                                        disabled>
                                                    <svg viewBox="0 0 24 24"
                                                         fill="none"
                                                         stroke="currentColor"
                                                         stroke-width="2"
                                                         stroke-linecap="round"
                                                         stroke-linejoin="round">
                                                        <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z" />
                                                        <circle cx="12" cy="12" r="3" />
                                                    </svg>
                                                </button>
                                            </div>

                                            <span asp-validation-for="CurrentPassword"
                                                  class="text-danger"></span>
                                        </div>

                                        <div class="mb-3">
                                            <label asp-for="NewPassword" class="form-label">
                                                New Password
                                            </label>

                                            <div class="password-input-wrapper">
                                                <input asp-for="NewPassword"
                                                       class="form-control"
                                                       id="profile-password"
                                                       type="password"
                                                       placeholder="Enter new password"
                                                       disabled />

                                                <button type="button"
                                                        class="toggle-password"
                                                        id="toggle-new-password"
                                                        aria-label="Hold to show password"
                                                        disabled>
                                                    <svg viewBox="0 0 24 24"
                                                         fill="none"
                                                         stroke="currentColor"
                                                         stroke-width="2"
                                                         stroke-linecap="round"
                                                         stroke-linejoin="round">
                                                        <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z" />
                                                        <circle cx="12" cy="12" r="3" />
                                                    </svg>
                                                </button>
                                            </div>

                                            <span asp-validation-for="NewPassword"
                                                  class="text-danger"></span>
                                        </div>

                                        <div>
                                            <label asp-for="ConfirmPassword" class="form-label">
                                                Confirm New Password
                                            </label>

                                            <div class="password-input-wrapper">
                                                <input asp-for="ConfirmPassword"
                                                       class="form-control"
                                                       id="confirm-password"
                                                       type="password"
                                                       placeholder="Confirm new password"
                                                       disabled />

                                                <button type="button"
                                                        class="toggle-password"
                                                        id="toggle-confirm-password"
                                                        aria-label="Hold to show password"
                                                        disabled>
                                                    <svg viewBox="0 0 24 24"
                                                         fill="none"
                                                         stroke="currentColor"
                                                         stroke-width="2"
                                                         stroke-linecap="round"
                                                         stroke-linejoin="round">
                                                        <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z" />
                                                        <circle cx="12" cy="12" r="3" />
                                                    </svg>
                                                </button>
                                            </div>

                                            <span asp-validation-for="ConfirmPassword"
                                                  class="text-danger"></span>
                                        </div>
                                        </div>
                                    </form>


                                </div>
                            </div>
                        </section>
                    </div>
                </div>
            </div>
        </div>

            <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
            <script src="~/lib/jquery/dist/jquery.min.js"></script>
            <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
            <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
            <script src="~/js/profile.js" asp-append-version="true"></script>

    </body>
</html>
