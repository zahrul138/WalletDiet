@model WalletDiet.ViewModels.ResetPasswordViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign up</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>

<body>

    <div class="gl position-relative overflow-hidden d-flex align-items-center justify-content-center">

        <div class="gl-blob gl-b1 position-absolute" aria-hidden="true"></div>
        <div class="gl-blob gl-b2 position-absolute" aria-hidden="true"></div>
        <div class="gl-blob gl-b3 position-absolute" aria-hidden="true"></div>

        <form class="card position-relative w-100" method="post" novalidate>

            <div class="card-body">

                <h1 class="text-center">Sign up</h1>

                <p class="gl-sub text-center">
                    Reset your password
                </p>

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="gl-field">

                    <label asp-for="Email" class="form-label"></label>

                    <input asp-for="Email"
                           class="form-control"
                           placeholder="Your email address"
                           autocomplete="email" 
                           readonly />

                    <span asp-validation-for="Email" class="text-danger"></span>

                </div>

                <input asp-for="Token" type="hidden" />

                <div class="gl-field">

                    <label asp-for="NewPassword" class="form-label">New Password</label>

                    <input asp-for="NewPassword"
                           class="form-control"
                           placeholder="New password"
                           autocomplete="current-password" />

                    <span asp-validation-for="NewPassword" class="text-danger"></span>

                </div>

                <div class="gl-field">

                    <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>

                    <input asp-for="ConfirmPassword"
                           class="form-control"
                           placeholder="Confirm password"
                           autocomplete="current-password" />

                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>

                </div>

                <button class="btn btn-gl w-100" type="submit">
                    Reset password
                </button>

            </div>

        </form>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

</body>

</html>
