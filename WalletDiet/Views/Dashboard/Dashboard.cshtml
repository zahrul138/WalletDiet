@model WalletDiet.ViewModels.DashboardViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Dashboard - WalletDiet</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>

<body>
    @if (TempData["ErrorMessage"] != null)
    {
        <script>
            alert('@TempData["ErrorMessage"]');
        </script>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="success-toast" id="successToast">

            <div class="success-toast-icon">
                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2.5"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <path d="M5 12l4 4L19 6" />

                </svg>
            </div>

            <span>@TempData["SuccessMessage"]</span>

        </div>
    }

    <div data-scene="dark" data-bs-theme="dark">

        <!-- Background Glass Scene -->
        <div class="g-scene" aria-hidden="true">
            <i></i>
            <i></i>
            <i></i>
            <i></i>
        </div>

        <main class="dashboard-wrap">
            <!-- Outer Glass -->
            <div class="dashboard-container">

                <div class="dashboard-topbar">

                    <div class="dashboard-brand">

                        <div class="brand-icon">
                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">

                                <rect x="3" y="6" width="18" height="15" rx="2" />
                                <path d="M3 10h18" />
                                <path d="M16 15h2" />
                                <path d="M6 6V4a2 2 0 0 1 2-2h11" />

                            </svg>
                        </div>

                        <h2>
                            Wallet<span>Diet</span>
                        </h2>

                    </div>


                    <a asp-controller="Account" asp-action="Profile" class="profile-button" aria-label="My Profile">
                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <circle cx="12" cy="8" r="4" />
                            <path d="M5 21v-2a7 7 0 0 1 14 0v2" />

                        </svg>
                    </a>
                </div>



                <!-- Inner Glass -->
                <section class="card g-glass countdown-card">

                    <div class="card-body">

                        <!-- Balance Header -->
                        <div class="balance-header">

                            <div>
                                <p class="balance-label">Total Balance</p>

                                <div class="balance-amount-wrapper">
                                    <h1 class="balance-amount">
                                        Rp @Model.TotalBalance.ToString("N0", new System.Globalization.CultureInfo("id-ID"))
                                    </h1>

                                    <span class="initial-balance">
                                        / of Rp @Model.InitialBalance.ToString("N0", new System.Globalization.CultureInfo("id-ID"))
                                    </span>
                                </div>
                            </div>

                            <div class="balance-icon">
                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">

                                    <rect x="3" y="6" width="18" height="15" rx="2" />
                                    <path d="M3 10h18" />
                                    <path d="M16 15h2" />
                                    <path d="M6 6V4a2 2 0 0 1 2-2h11" />

                                </svg>
                            </div>

                        </div>

                        <!-- Balance Period -->
                        <div class="balance-period">

                            <span>
                                @Model.StartDate.ToString("MMM dd, yyyy")
                                –
                                @Model.TargetDate.ToString("MMM dd, yyyy")
                            </span>

                            <span class="remaining-days">
                                @Model.RemainingDays days remaining
                            </span>

                        </div>

                        <!-- Budget Usage -->
                        <div class="usage-section">

                            <div class="section-heading">

                                <span class="section-title">
                                    Budget Usage
                                </span>

                                <span class="usage-percentage">
                                    @Model.BudgetUsage.ToString("N1")%
                                </span>

                            </div>

                            <div class="usage-progress"
                                 role="progressbar"
                                 aria-label="Budget usage"
                                 aria-valuenow="23.3"
                                 aria-valuemin="0"
                                 aria-valuemax="100">

                                <div class="usage-progress-bar"
                                     style="width: @Math.Clamp(Model.BudgetUsage, 0, 100)%;">
                                </div>

                            </div>

                            <div class="usage-information">

                                <span>
                                    Spent Rp @Model.TotalExpense.ToString("N0", new System.Globalization.CultureInfo("id-ID"))
                                </span>

                                <span>
                                    Remaining Rp @Model.TotalBalance.ToString("N0", new System.Globalization.CultureInfo("id-ID"))
                                </span>

                            </div>

                        </div>

                    </div>

                </section>


                <!-- Daily Allowance Glass -->
                <section class="card g-glass daily-card">

                    <div class="card-body">

                        <!-- Daily Allowance Header -->
                        <div class="daily-header">

                            <h2 class="daily-title">Daily Allowance</h2>

                            <div class="daily-icon">
                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">

                                    <rect x="3" y="4" width="18" height="17" rx="2" />
                                    <path d="M16 2v4M8 2v4M3 10h18" />
                                    <path d="M8 14h.01M12 14h.01M16 14h.01" />

                                </svg>
                            </div>

                        </div>

                        <!-- Daily Allowance Amount -->
                        <h2 class="daily-amount">
                            Rp @Model.DailyAllowance.ToString("N0", new System.Globalization.CultureInfo("id-ID"))
                        </h2>

                        <!-- Daily Spending -->
                        <div class="daily-usage">

                            <div class="daily-information">

                                <span>
                                    Spent Rp @Model.DailySpent.ToString("N0", new System.Globalization.CultureInfo("id-ID"))
                                </span>

                                <span>
                                    Left Rp @Model.DailyRemaining.ToString("N0", new System.Globalization.CultureInfo("id-ID"))
                                </span>

                            </div>

                            @{
                                var dailyUsage = Model.DailyAllowance > 0
                                ? (Model.DailySpent / Model.DailyAllowance) * 100
                                : 0;
                            }

                            <div class="daily-progress">
                                <div class="daily-progress-bar"
                                     style="width: @Math.Clamp(dailyUsage, 0, 100)%;">
                                </div>
                            </div>

                        </div>

                    </div>

                </section>


                <!-- Inner Glass 3: Add Expense -->
                <section class="card g-glass expense-card">

                    <div class="card-body">

                        <h3 class="expense-title">Add Expense</h3>

                        <form asp-controller="Dashboard" asp-action="AddExpense" method="post" id="expenseForm" novalidate>
                            @Html.AntiForgeryToken()

                            <!-- Expense Name -->
                            <div class="expense-form-group">
                                <label for="expenseName" class="expense-label">
                                    Expense Name
                                </label>

                                <input type="text"
                                       id="expenseName"
                                       name="Title"
                                       class="expense-input"
                                       placeholder="e.g. Lunch, Coffee, Gasoline" />

                                <span class="field-error" id="titleError">@TempData["TitleError"]</span>
                            </div>


                            <!-- Amount -->
                            <div class="expense-form-group">

                                <label for="expenseAmountDisplay" class="expense-label">
                                    Amount
                                </label>

                                <div class="input-wrapper">
                                    <span class="input-prefix">Rp</span>

                                    <input type="text"
                                           id="expenseAmountDisplay"
                                           class="expense-input currency-input"
                                           placeholder="00.000.000"
                                           inputmode="numeric"
                                           autocomplete="off" />

                                    <input type="hidden"
                                           name="Amount"
                                           id="expenseAmountValue" />
                                </div>

                                <span class="field-error" id="amountError">@TempData["AmountError"]</span>

                            </div>


                            <!-- Category -->
                            <div class="expense-form-group">

                                <label class="expense-label">
                                    Category
                                </label>

                                <div class="expense-category-options">

                                    <input type="radio"
                                           name="Category"
                                           id="categoryFood"
                                           value="Food" />

                                    <label for="categoryFood" class="category-chip">
                                        Food
                                    </label>


                                    <input type="radio"
                                           name="Category"
                                           id="categoryTransport"
                                           value="Transport" />

                                    <label for="categoryTransport" class="category-chip">
                                        Transport
                                    </label>


                                    <input type="radio"
                                           name="Category"
                                           id="categoryShopping"
                                           value="Shopping" />

                                    <label for="categoryShopping" class="category-chip">
                                        Shopping
                                    </label>


                                    <input type="radio"
                                           name="Category"
                                           id="categoryOther"
                                           value="Other" />

                                    <label for="categoryOther" class="category-chip">
                                        Other
                                    </label>

                                </div>

                                <span class="field-error" id="categoryError">@TempData["CategoryError"]</span>

                            </div>


                            <!-- Save Button -->
                            <button type="submit" class="expense-submit-button">
                                Save Expense
                            </button>

                        </form>

                    </div>

                </section>

                <section class="history-section">

                    <div class="history-heading">
                        <h3 class="history-title">Expense History</h3>
                        <span class="history-hint">Scroll to explore</span>
                    </div>


                    <div class="history-scroll">

                        @if (Model.Expenses.Any())
                        {
                            var historyDays = Model.Expenses
                            .GroupBy(e => e.CreatedAt.Date)
                            .OrderByDescending(g => g.Key);

                            foreach (var day in historyDays)
                            {
                                var visibleExpenses = day.Take(4).ToList();
                                var hiddenCount = day.Count() - visibleExpenses.Count;

                                <article class="card g-glass history-day-card">

                                    <div class="card-body">

                                        <div class="history-card-header">
                                            <h4 class="history-date">
                                                @(day.Key == DateTime.Today
                                                    ? "Today"
                                                    : day.Key.ToString("MMM dd, yyyy"))
                                    </h4>

                                            <span class="history-item-count">
                                                @day.Count() items
                                            </span>
                                        </div>

                                        <div class="history-expense-list">

                                    @foreach (var expense in visibleExpenses)
                                            {
                                                <div class="history-expense-item">

                                                    <div class="history-expense-details">
                                                        <span class="history-expense-name">
                                                            @expense.Title
                                                        </span>

                                                        <span class="history-expense-category">
                                                            @expense.Category
                                                        </span>
                                                    </div>

                                                    <div class="history-expense-actions">

                                                        <span class="history-expense-amount">
                                                            Rp @expense.Amount.ToString("N0", new System.Globalization.CultureInfo("id-ID"))
                                                        </span>

                                                        <form asp-controller="Dashboard"
                                                              asp-action="DeleteExpense"
                                                              method="post"
                                                              class="delete-expense-form">

                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@expense.Id" />

                                                            <button type="submit"
                                                                    class="delete-expense-btn"
                                                                    title="Delete expense">

                                                                <svg viewBox="0 0 24 24" fill="none"
                                                                     stroke="currentColor" stroke-width="1.8"
                                                                     stroke-linecap="round" stroke-linejoin="round">
                                                                    <polyline points="3 6 5 6 21 6"></polyline>
                                                                    <path d="M19 6l-1 14H6L5 6"></path>
                                                                    <path d="M10 11v6"></path>
                                                                    <path d="M14 11v6"></path>
                                                                    <path d="M9 6V4h6v2"></path>
                                                                </svg>

                                                            </button>
                                                        </form>

                                                    </div>

                                                </div>
                                            }

                                        </div>

                                        @if (hiddenCount > 0)
                                        {
                                            <div class="history-card-footer">
                                                <a asp-controller="Dashboard"
                                                   asp-action="DailyDetails"
                                                   asp-route-date="@day.Key.ToString("yyyy-MM-dd")"
                                                   class="history-see-link">

                                                    See (@hiddenCount)

                                                </a>
                                            </div>
                                        }

                                    </div>

                                </article>
                            }
                        }
                        else
                        {
                            <p class="history-empty">
                                No expenses recorded yet.
                            </p>
                        }

                    </div>


                </section>


            </div>

        </main>

    </div>

    <div class="delete-modal" id="deleteExpenseModal">
        <div class="delete-modal-content">
            <div class="delete-modal-icon">
                <svg viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.8"
                     stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="3 6 5 6 21 6"></polyline>
                    <path d="M19 6l-1 14H6L5 6"></path>
                    <path d="M10 11v6"></path>
                    <path d="M14 11v6"></path>
                    <path d="M9 6V4h6v2"></path>
                </svg>
            </div>

            <h3>Delete Expense?</h3>

            <p>
                Are you sure you want to delete this expense?
                This action cannot be undone.
            </p>

            <div class="delete-modal-actions">
                <button type="button" id="cancelDeleteExpense">
                    Cancel
                </button>

                <button type="button" id="confirmDeleteExpense">
                    Delete Expense
                </button>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/expense.js" asp-append-version="true"></script>

</body>
</html>
