@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Dashboard - WalletDiet</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>

<body>

    <div data-scene="dark" data-bs-theme="dark">

        <!-- Background Glass Scene -->
        <div class="g-scene" aria-hidden="true">
            <i></i>
            <i></i>
            <i></i>
            <i></i>
        </div>

        <main class="dashboard-wrap">
            <!-- Outer Glass -->
            <div class="dashboard-container">

                <div class="dashboard-topbar">

                    <div class="dashboard-brand">

                        <div class="brand-icon">
                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">

                                <rect x="3" y="6" width="18" height="15" rx="2" />
                                <path d="M3 10h18" />
                                <path d="M16 15h2" />
                                <path d="M6 6V4a2 2 0 0 1 2-2h11" />

                            </svg>
                        </div>

                        <h2>
                            Wallet<span>Diet</span>
                        </h2>

                    </div>


                    <a asp-controller="Account" asp-action="Profile" class="profile-button" aria-label="My Profile">
                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <circle cx="12" cy="8" r="4" />
                            <path d="M5 21v-2a7 7 0 0 1 14 0v2" />

                        </svg>
                    </a>
                </div>



                <!-- Inner Glass -->
                <section class="card g-glass countdown-card">

                    <div class="card-body">

                        <!-- Balance Header -->
                        <div class="balance-header">

                            <div>
                                <p class="balance-label">Total Balance</p>

                                <div class="balance-amount-wrapper">
                                    <h1 class="balance-amount">
                                        Rp 2.300.000
                                    </h1>

                                    <span class="initial-balance">
                                        / of Rp 3.000.000
                                    </span>
                                </div>
                            </div>

                            <div class="balance-icon">
                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">

                                    <rect x="3" y="6" width="18" height="15" rx="2" />
                                    <path d="M3 10h18" />
                                    <path d="M16 15h2" />
                                    <path d="M6 6V4a2 2 0 0 1 2-2h11" />

                                </svg>
                            </div>

                        </div>

                        <!-- Balance Period -->
                        <div class="balance-period">

                            <span>Nov 24, 2026 – Dec 17, 2026</span>

                            <span class="remaining-days">
                                23 days remaining
                            </span>

                        </div>

                        <!-- Budget Usage -->
                        <div class="usage-section">

                            <div class="section-heading">

                                <span class="section-title">
                                    Budget Usage
                                </span>

                                <span class="usage-percentage">
                                    23.3%
                                </span>

                            </div>

                            <div class="usage-progress"
                                 role="progressbar"
                                 aria-label="Budget usage"
                                 aria-valuenow="23.3"
                                 aria-valuemin="0"
                                 aria-valuemax="100">

                                <div class="usage-progress-bar"></div>

                            </div>

                            <div class="usage-information">

                                <span>Spent Rp 700,000</span>

                                <span>Remaining Rp 2,300,000</span>

                            </div>

                        </div>

                    </div>

                </section>


                <!-- Daily Allowance Glass -->
                <section class="card g-glass daily-card">

                    <div class="card-body">

                        <!-- Daily Allowance Header -->
                        <div class="daily-header">

                            <h2 class="daily-title">Daily Allowance</h2>

                            <div class="daily-icon">
                                <svg viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="1.8"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">

                                    <rect x="3" y="4" width="18" height="17" rx="2" />
                                    <path d="M16 2v4M8 2v4M3 10h18" />
                                    <path d="M8 14h.01M12 14h.01M16 14h.01" />

                                </svg>
                            </div>

                        </div>

                        <!-- Daily Allowance Amount -->
                        <h2 class="daily-amount">Rp 100.000</h2>

                        <!-- Daily Spending -->
                        <div class="daily-usage">

                            <div class="daily-information">

                                <span>Spent Rp 35.000</span>

                                <span>Left Rp 65.000</span>

                            </div>

                            <div class="daily-progress">
                                <div class="daily-progress-bar"></div>
                            </div>

                        </div>

                    </div>

                </section>


                <!-- Inner Glass 3: Add Expense -->
                <section class="card g-glass expense-card">

                    <div class="card-body">

                        <h3 class="expense-title">Add Expense</h3>

                        <form>

                            <!-- Expense Name -->
                            <div class="expense-form-group">
                                <label for="expenseName" class="expense-label">
                                    Expense Name
                                </label>

                                <input type="text"
                                       id="expenseName"
                                       name="ExpenseName"
                                       class="expense-input"
                                       placeholder="e.g. Lunch, Coffee, Gasoline" />
                            </div>


                            <!-- Amount -->
                            <div class="expense-form-group">
                                <label for="expenseAmount" class="expense-label">
                                    Amount
                                </label>

                                <input type="number"
                                       id="expenseAmount"
                                       name="Amount"
                                       class="expense-input"
                                       placeholder="Rp 0"
                                       min="1" />
                            </div>


                            <!-- Category -->
                            <div class="expense-form-group">

                                <label class="expense-label">
                                    Category
                                </label>

                                <div class="expense-category-options">

                                    <input type="radio"
                                           name="Category"
                                           id="categoryFood"
                                           value="Food"
                                           checked />

                                    <label for="categoryFood" class="category-chip">
                                        Food
                                    </label>


                                    <input type="radio"
                                           name="Category"
                                           id="categoryTransport"
                                           value="Transport" />

                                    <label for="categoryTransport" class="category-chip">
                                        Transport
                                    </label>


                                    <input type="radio"
                                           name="Category"
                                           id="categoryShopping"
                                           value="Shopping" />

                                    <label for="categoryShopping" class="category-chip">
                                        Shopping
                                    </label>


                                    <input type="radio"
                                           name="Category"
                                           id="categoryOther"
                                           value="Other" />

                                    <label for="categoryOther" class="category-chip">
                                        Other
                                    </label>

                                </div>

                            </div>


                            <!-- Save Button -->
                            <button type="button" class="expense-submit-button">
                                Save Expense
                            </button>

                        </form>

                    </div>

                </section>

                @{
                    var historyDays = new[]
                    {
                                new
                                {
                                Date = "Today",
                                HiddenCount = 2,
                                Expenses = new[]
                                {
                                new { Name = "Lunch", Category = "Food", Amount = "Rp 25.000" },
                                new { Name = "Coffee", Category = "Food", Amount = "Rp 15.000" },
                                new { Name = "Gasoline", Category = "Transport", Amount = "Rp 20.000" },
                                new { Name = "Parking", Category = "Transport", Amount = "Rp 5.000" }
                                }
                                },
                                new
                                {
                                Date = "Nov 23, 2026",
                                HiddenCount = 0,
                                Expenses = new[]
                                {
                                new { Name = "Breakfast", Category = "Food", Amount = "Rp 20.000" },
                                new { Name = "Bus Ticket", Category = "Transport", Amount = "Rp 10.000" },
                                new { Name = "Groceries", Category = "Shopping", Amount = "Rp 45.000" },
                                new { Name = "Snacks", Category = "Food", Amount = "Rp 12.000" }
                                }
                                },
                                new
                                {
                                Date = "Nov 22, 2026",
                                HiddenCount = 0,
                                Expenses = new[]
                                {
                                new { Name = "Lunch", Category = "Food", Amount = "Rp 30.000" },
                                new { Name = "Parking", Category = "Transport", Amount = "Rp 5.000" },
                                new { Name = "Mineral Water", Category = "Food", Amount = "Rp 5.000" },
                                new { Name = "Soap", Category = "Shopping", Amount = "Rp 18.000" }
                                }
                                },
                                new
                                {
                                Date = "Nov 21, 2026",
                                HiddenCount = 0,
                                Expenses = new[]
                                {
                                new { Name = "Breakfast", Category = "Food", Amount = "Rp 15.000" },
                                new { Name = "Gasoline", Category = "Transport", Amount = "Rp 25.000" },
                                new { Name = "Dinner", Category = "Food", Amount = "Rp 28.000" },
                                new { Name = "Laundry", Category = "Other", Amount = "Rp 20.000" }
                                }
                                },
                                new
                                {
                                Date = "Nov 20, 2026",
                                HiddenCount = 0,
                                Expenses = new[]
                                {
                                new { Name = "Lunch", Category = "Food", Amount = "Rp 25.000" },
                                new { Name = "Coffee", Category = "Food", Amount = "Rp 15.000" },
                                new { Name = "Train Ticket", Category = "Transport", Amount = "Rp 12.000" },
                                new { Name = "Groceries", Category = "Shopping", Amount = "Rp 35.000" }
                                }
                                },
                                new
                                {
                                Date = "Nov 19, 2026",
                                HiddenCount = 0,
                                Expenses = new[]
                                {
                                new { Name = "Breakfast", Category = "Food", Amount = "Rp 18.000" },
                                new { Name = "Gasoline", Category = "Transport", Amount = "Rp 20.000" },
                                new { Name = "Medicine", Category = "Other", Amount = "Rp 15.000" },
                                new { Name = "Dinner", Category = "Food", Amount = "Rp 30.000" }
                                }
                                },
                                new
                                {
                                Date = "Nov 18, 2026",
                                HiddenCount = 0,
                                Expenses = new[]
                                {
                                new { Name = "Lunch", Category = "Food", Amount = "Rp 25.000" },
                                new { Name = "Parking", Category = "Transport", Amount = "Rp 5.000" },
                                new { Name = "Toiletries", Category = "Shopping", Amount = "Rp 22.000" },
                                new { Name = "Snacks", Category = "Food", Amount = "Rp 10.000" }
                                }
                                },
                                new
                                {
                                Date = "Nov 17, 2026",
                                HiddenCount = 0,
                                Expenses = new[]
                                {
                                new { Name = "Breakfast", Category = "Food", Amount = "Rp 20.000" },
                                new { Name = "Bus Ticket", Category = "Transport", Amount = "Rp 10.000" },
                                new { Name = "Lunch", Category = "Food", Amount = "Rp 25.000" },
                                new { Name = "Stationery", Category = "Shopping", Amount = "Rp 15.000" }
                                }
                                }
                                };
                }

                <section class="history-section">

                    <div class="history-heading">
                        <h3 class="history-title">Expense History</h3>
                        <span class="history-hint">Scroll to explore</span>
                    </div>

                    <div class="history-scroll">

                        @foreach (var day in historyDays)
                        {
                            <article class="card g-glass history-day-card">

                                <div class="card-body">

                                    <div class="history-card-header">
                                        <h4 class="history-date">@day.Date</h4>

                                        <span class="history-item-count">
                                            @(day.Expenses.Length + day.HiddenCount) items
                                        </span>
                                    </div>

                                    <div class="history-expense-list">

                                        @foreach (var expense in day.Expenses)
                                        {
                                            <div class="history-expense-item">

                                                <div class="history-expense-details">
                                                    <span class="history-expense-name">
                                                        @expense.Name
                                                    </span>

                                                    <span class="history-expense-category">
                                                        @expense.Category
                                                    </span>
                                                </div>

                                                <span class="history-expense-amount">
                                                    @expense.Amount
                                                </span>

                                            </div>
                                        }

                                    </div>

                                    @if (day.HiddenCount > 0)
                                    {
                                        <div class="history-card-footer">
                                            <a href="@Url.Action("Dashboard", "Dashboard")"
                                               class="history-see-link">
                                                See (@day.HiddenCount)
                                            </a>
                                        </div>
                                    }

                                </div>

                            </article>
                        }

                    </div>

                </section>



            </div>

        </main>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
