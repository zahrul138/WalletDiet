@model WalletDiet.ViewModels.DailyDetailsViewModel

@using System.Globalization

@{
    Layout = null;

    var culture = new CultureInfo("id-ID");

    var dailyUsage = Model.DailyAllowance > 0
        ? (Model.DailySpent / Model.DailyAllowance) * 100
        : 0;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Daily Details - WalletDiet</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/daily-details.css" asp-append-version="true" />
</head>

<body>

    <div data-scene="dark" data-bs-theme="dark">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="success-toast" id="successToast">

                <div class="success-toast-icon">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2.5"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M5 12l4 4L19 6" />

                    </svg>
                </div>

                <span>@TempData["SuccessMessage"]</span>

            </div>
        }

        <!-- Background Glass Scene -->
        <div class="g-scene" aria-hidden="true">
            <i></i>
            <i></i>
            <i></i>
            <i></i>
        </div>

        <main class="dashboard-wrap">

            <div class="dashboard-container">

                <!-- Topbar -->
                <div class="dashboard-topbar">

                    <div class="dashboard-brand">

                        <div class="brand-icon">
                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.8"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">

                                <rect x="3" y="6" width="18" height="15" rx="2" />
                                <path d="M3 10h18" />
                                <path d="M16 15h2" />
                                <path d="M6 6V4a2 2 0 0 1 2-2h11" />
                            </svg>
                        </div>

                        <h2>Wallet<span>Diet</span></h2>

                    </div>

                    <a asp-controller="Account"
                       asp-action="Profile"
                       class="profile-button"
                       aria-label="My Profile">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <circle cx="12" cy="8" r="4" />
                            <path d="M5 21v-2a7 7 0 0 1 14 0v2" />
                        </svg>
                    </a>

                </div>

                <!-- Page Heading -->
                <header class="details-header">

                    <a asp-controller="Dashboard"
                       asp-action="Dashboard"
                       class="back-link">
                        &larr; Back to Dashboard
                    </a>

                    <h1>Daily Details</h1>

                    <p class="details-date">
                        @Model.Date.ToString("dddd, MMMM dd, yyyy", CultureInfo.InvariantCulture)
                    </p>

                </header>

                <!-- Daily Allowance -->
                <section class="card g-glass daily-card">

                    <div class="card-body">

                        <div class="daily-header">
                            <h2 class="daily-title">Daily Allowance</h2>

                            <span class="details-date-label">
                                @Model.Date.ToString("MMM dd", CultureInfo.InvariantCulture)
                            </span>
                        </div>

                        <h2 class="daily-amount">
                            Rp @Model.DailyAllowance.ToString("N0", culture)
                        </h2>

                        <div class="daily-usage">

                            <div class="daily-information">
                                <span>
                                    Spent Rp @Model.DailySpent.ToString("N0", culture)
                                </span>

                                <span class="@(Model.DailyRemaining < 0 ? "details-negative" : "")">
                                    Left Rp @Model.DailyRemaining.ToString("N0", culture)
                                </span>
                            </div>

                            <div class="daily-progress">
                                <div class="daily-progress-bar"
                                     style="width: @Math.Clamp(dailyUsage, 0, 100).ToString("0.##", CultureInfo.InvariantCulture)%;">
                                </div>
                            </div>

                        </div>

                    </div>

                </section>

                <!-- Expense History -->
                <section class="history-section details-history-section">

                    <div class="history-heading">

                        <h3 class="history-title">Expense History</h3>

                        <span class="history-hint">
                            @Model.Expenses.Count items
                        </span>

                    </div>

                    @if (Model.Expenses.Any())
                    {
                        <div class="details-expense-list">

                            @foreach (var expense in Model.Expenses)
                            {
                                <div class="history-expense-item details-expense-item">

                                    <div class="history-expense-details">

                                        <span class="history-expense-name">
                                            @expense.Title
                                        </span>

                                        <span class="history-expense-category">
                                            @expense.Category · @expense.CreatedAt.ToString("HH:mm")
                                        </span>

                                    </div>

                                    <div class="history-expense-actions">

                                        <span class="history-expense-amount">
                                            Rp @expense.Amount.ToString("N0", culture)
                                        </span>

                                        <form asp-controller="Dashboard"
                                              asp-action="DeleteExpense"
                                              method="post"
                                              class="delete-expense-form">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@expense.Id" />

                                            <input type="hidden"
                                                   name="returnDate"
                                                   value="@Model.Date.ToString("yyyy-MM-dd")" />

                                            <button type="submit"
                                                    class="delete-expense-btn"
                                                    title="Delete expense">

                                                <svg viewBox="0 0 24 24"
                                                     fill="none"
                                                     stroke="currentColor"
                                                     stroke-width="1.8"
                                                     stroke-linecap="round"
                                                     stroke-linejoin="round">

                                                    <polyline points="3 6 5 6 21 6"></polyline>
                                                    <path d="M19 6l-1 14H6L5 6"></path>
                                                    <path d="M10 11v6"></path>
                                                    <path d="M14 11v6"></path>
                                                    <path d="M9 6V4h6v2"></path>
                                                </svg>

                                            </button>

                                        </form>

                                    </div>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <p class="details-empty">
                            No expenses recorded on this day.
                        </p>
                    }

                </section>

            </div>

        </main>

    </div>

    <!-- Delete Confirmation Modal -->
    <div class="delete-modal" id="deleteExpenseModal">

        <div class="delete-modal-content">

            <div class="delete-modal-icon">
                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <polyline points="3 6 5 6 21 6"></polyline>
                    <path d="M19 6l-1 14H6L5 6"></path>
                    <path d="M10 11v6"></path>
                    <path d="M14 11v6"></path>
                    <path d="M9 6V4h6v2"></path>
                </svg>
            </div>

            <h3>Delete Expense?</h3>

            <p>
                Are you sure you want to delete this expense?
                This action cannot be undone.
            </p>

            <div class="delete-modal-actions">

                <button type="button" id="cancelDeleteExpense">
                    Cancel
                </button>

                <button type="button" id="confirmDeleteExpense">
                    Delete Expense
                </button>

            </div>

        </div>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/daily-details.js" asp-append-version="true"></script>

</body>
</html>
